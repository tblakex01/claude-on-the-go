# Claude-on-the-Go Configuration
# Copy this file to .env and customize as needed

# Security
ALLOWED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001
MAX_CONNECTIONS=1
ENABLE_AUTH=false
AUTH_TOKEN=

# Network (leave empty for auto-detection)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8001

# Rate Limiting
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_BYTES=100000

# Logging
LOG_LEVEL=INFO
LOG_REDACTION=true

# Claude CLI
CLAUDE_COMMAND=claude
